# Only needed when you deploy. Locally the app uses data/skillswap.db.
# Get these from https://turso.tech (free): create a database, then copy its URL
# and create a token with:  turso db tokens create <database-name>

TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Optional: set to "off" to hide the demo accounts and on-screen reset links.
# DEMO_MODE=off
